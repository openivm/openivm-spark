# Pinned dependencies for the openivm-spark dev container.
# Immutable native and LPTS revisions consumed by the dev and CI builds.

# Native OpenIVM source and its source-pinned extension dependencies.
OPENIVM_REPO=https://github.com/mdrakiburrahman/openivm.git
OPENIVM_BRANCH=mdrakiburrahman/late-append-key-trim-main
OPENIVM_COMMIT=1b128fecdc2360cc646ec4b11f4a2ea7f1f4107f
EXTENSION_CI_TOOLS_COMMIT=c286b12cee2aa16b714e76d0b46e530fcdb6dc05

# LPTS source and its DuckLake gitlink.
LPTS_REPO=https://github.com/cwida/lpts.git
LPTS_BRANCH=main
LPTS_COMMIT=84390b1246d229ee584db74dd567a181db071227
LPTS_DUCKLAKE_COMMIT=4c7bb6ad175814f05cfd1af69d90f8418bb04c16

# vcpkg is pinned independently because the qualified native source uses this toolchain revision.
VCPKG_REPO=https://github.com/microsoft/vcpkg.git
VCPKG_COMMIT=cd61e1e26a038e82d6550a3ebbe0fbbfe7da78e3

# IVM bench working repo
IVM_BENCH_REPO=https://github.com/mdrakiburrahman/ivm-bench.git
IVM_BENCH_BRANCH=main
IVM_BENCH_COMMIT=5f471d5009af326b2349a9ea8c4c6760277f11c3

# Shared toolchain
SBT_VERSION=1.9.7
ANTLR_VERSION=4.9.3

# Build the extension against this exact DuckDB source; run it with the matching
# official, explicitly dynamically-loaded v2.0.0 CLI in the image.
DUCKDB_REF=v2.0.0
DUCKDB_COMMIT=d54cbbe3df17e8e5ce68312f483b4155836112aa
DUCKDB_CLI_VERSION=v2.0.0
DUCKDB_CLI_SHA256=c6507206baf7793c6013dbd82368469a45f20dc0e17a6f92f204602f652ed2bc
NATIVE_BUILD_JOBS=16

# Ubuntu mirror override for slow networks (passes through to apt sources)
UBUNTU_MIRROR=http://archive.ubuntu.com/ubuntu
