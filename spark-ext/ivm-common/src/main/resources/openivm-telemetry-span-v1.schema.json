{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openivm.execution-span",
  "title": "OpenIVM completed execution span",
  "x-openivm-w6-required-success-fields": [
    "schema_id",
    "schema_version",
    "campaign_id",
    "request_id",
    "correlation_id",
    "dbt_node_id",
    "materialized_view",
    "operation",
    "phase",
    "engine_started_at",
    "engine_completed_at",
    "duration_ms",
    "driver_thread",
    "outcome",
    "compile_refresh_type",
    "effective_refresh_type",
    "refresh_reason",
    "time_travel_pin_status",
    "time_travel_pin_reason",
    "source_versions",
    "pending_delta_count"
  ],
  "x-openivm-operation-success-outcomes": {
    "create": [
      "create_executed",
      "create_already_exists"
    ],
    "refresh": [
      "source_versions_already_applied",
      "no_pending_deltas",
      "noop_fast_exit",
      "full_refresh_executed",
      "runtime_empty_delta_skip",
      "incremental_executed",
      "committed_with_cleanup_warning"
    ]
  },
  "x-openivm-outcomes-requiring-source-versions": [
    "create_executed",
    "create_already_exists",
    "source_versions_already_applied",
    "no_pending_deltas",
    "noop_fast_exit",
    "full_refresh_executed",
    "runtime_empty_delta_skip",
    "incremental_executed",
    "committed_with_cleanup_warning"
  ],
  "x-openivm-source-version-order": "canonical_relation_ascending",
  "x-openivm-source-version-uniqueness": "canonical_relation",
  "x-openivm-duration-timestamp-tolerance-ms": 5,
  "x-openivm-duplicate-fields": "reject",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "campaign_id",
    "request_id",
    "correlation_id",
    "dbt_node_id",
    "materialized_view",
    "operation",
    "phase",
    "engine_started_at",
    "engine_completed_at",
    "duration_ms",
    "driver_thread",
    "outcome",
    "source_versions",
    "pending_delta_count"
  ],
  "properties": {
    "schema_id": {
      "const": "openivm.execution-span"
    },
    "schema_version": {
      "const": 1
    },
    "campaign_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "dbt_node_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "materialized_view": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "operation": {
      "enum": [
        "create",
        "refresh"
      ]
    },
    "phase": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "engine_started_at": {
      "type": "string",
      "format": "date-time"
    },
    "engine_completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "driver_thread": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "type": "string",
      "minLength": 1
    },
    "compile_refresh_type": {
      "type": "string",
      "minLength": 1
    },
    "effective_refresh_type": {
      "type": "string",
      "minLength": 1
    },
    "refresh_reason": {
      "type": "string",
      "minLength": 1
    },
    "time_travel_pin_status": {
      "type": "string",
      "minLength": 1
    },
    "time_travel_pin_reason": {
      "type": "string",
      "minLength": 1
    },
    "source_versions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "relation",
          "start_version",
          "end_version"
        ],
        "properties": {
          "relation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "start_version": {
            "type": "integer",
            "minimum": 0
          },
          "end_version": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "pending_delta_count": {
      "type": "integer",
      "minimum": 0
    },
    "same_mv_lock_wait_ms": {
      "description": "Legacy total: sum of wait_ms across recorded lock_acquisitions, including dependency keys and CREATE publication guards. Excludes dependency discovery, identity validation, admission, and the protected body.",
      "type": "integer",
      "minimum": 0
    },
    "driver_admission_wait_ms": {
      "type": "integer",
      "minimum": 0
    },
    "catalog_publication_admission_width": {
      "type": "integer",
      "minimum": 0
    },
    "catalog_publication_admission_wait_ms": {
      "type": "integer",
      "minimum": 0
    },
    "compiler_ms": {
      "type": "integer",
      "minimum": 0
    },
    "catalog_ms": {
      "type": "integer",
      "minimum": 0
    },
    "analysis_ms": {
      "type": "integer",
      "minimum": 0
    },
    "watermark_ms": {
      "type": "integer",
      "minimum": 0
    },
    "ctas_ms": {
      "type": "integer",
      "minimum": 0
    },
    "ctas_data_write_ms": {
      "type": "integer",
      "minimum": 0
    },
    "hive_catalog_publication_ms": {
      "type": "integer",
      "minimum": 0
    },
    "metadata_publication_ms": {
      "type": "integer",
      "minimum": 0
    },
    "delta_version_lookup_ms": {
      "type": "integer",
      "minimum": 0
    },
    "delta_version_lookup_count": {
      "type": "integer",
      "minimum": 0
    },
    "rocksdb_write_ms": {
      "type": "integer",
      "minimum": 0
    },
    "rocksdb_write_count": {
      "type": "integer",
      "minimum": 0
    },
    "rocksdb_flush_ms": {
      "type": "integer",
      "minimum": 0
    },
    "rocksdb_flush_count": {
      "type": "integer",
      "minimum": 0
    },
    "rocksdb_flush_failed_count": {
      "type": "integer",
      "minimum": 0
    },
    "rocksdb_jvm_lock_wait_ms": {
      "type": "integer",
      "minimum": 0
    },
    "rocksdb_external_lock_wait_ms": {
      "type": "integer",
      "minimum": 0
    },
    "rocksdb_backup_ms": {
      "type": "integer",
      "minimum": 0
    },
    "clock_domain_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "duration_ns": {
      "type": "integer",
      "minimum": 0
    },
    "post_completion_ns": {
      "type": "integer",
      "minimum": 0
    },
    "owner_thread_wrapped_ns": {
      "type": "integer",
      "minimum": 0
    },
    "owner_thread_post_completion_wrapped_ns": {
      "type": "integer",
      "minimum": 0
    },
    "owner_thread_coverage_status": {
      "type": "string",
      "enum": [
        "complete",
        "incomplete",
        "inconsistent"
      ]
    },
    "owner_thread_coverage_reason": {
      "type": "string",
      "enum": [
        "active_wrappers_at_freeze",
        "wrapped_exceeds_span"
      ]
    },
    "deep_status": {
      "type": "string",
      "enum": [
        "augmentation_failed"
      ]
    },
    "owner_thread_unattributed_ns": {
      "type": "integer",
      "minimum": 0
    },
    "owner_thread_overcoverage_ns": {
      "type": "integer",
      "minimum": 0
    },
    "active_wrappers_at_freeze": {
      "type": "integer",
      "minimum": 0
    },
    "phase_totals_dropped_count": {
      "type": "integer",
      "minimum": 0
    },
    "timer_totals_dropped_count": {
      "type": "integer",
      "minimum": 0
    },
    "work_counters_dropped_count": {
      "type": "integer",
      "minimum": 0
    },
    "deep_names_truncated_count": {
      "type": "integer",
      "minimum": 0
    },
    "deep_observer_ns": {
      "type": "integer",
      "minimum": 0
    },
    "phase_totals": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "phase",
          "wrapped_count",
          "wrapped_failed_count",
          "wrapped_ns",
          "wrapped_max_ns",
          "owner_top_level_count",
          "off_thread_count",
          "external_count",
          "external_ms",
          "skipped_count"
        ],
        "properties": {
          "phase": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "wrapped_count": {
            "type": "integer",
            "minimum": 0
          },
          "wrapped_failed_count": {
            "type": "integer",
            "minimum": 0
          },
          "wrapped_ns": {
            "type": "integer",
            "minimum": 0
          },
          "wrapped_max_ns": {
            "type": "integer",
            "minimum": 0
          },
          "owner_top_level_count": {
            "type": "integer",
            "minimum": 0
          },
          "off_thread_count": {
            "type": "integer",
            "minimum": 0
          },
          "external_count": {
            "type": "integer",
            "minimum": 0
          },
          "external_ms": {
            "type": "integer",
            "minimum": 0
          },
          "skipped_count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "timer_totals": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "timer",
          "count",
          "total_ns",
          "max_ns"
        ],
        "properties": {
          "timer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "total_ns": {
            "type": "integer",
            "minimum": 0
          },
          "max_ns": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "work_counters": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "counter",
          "value"
        ],
        "properties": {
          "counter": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "value": {
            "type": "integer"
          }
        }
      }
    },
    "lock_acquisitions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mv_key",
          "mode",
          "requested_epoch_ms",
          "acquired_epoch_ms",
          "released_epoch_ms",
          "wait_ms",
          "hold_ms",
          "thread"
        ],
        "properties": {
          "mv_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "lock_kind": {
            "type": "string",
            "enum": [
              "mv_data",
              "create_publication"
            ]
          },
          "mode": {
            "type": "string",
            "enum": [
              "read",
              "write"
            ]
          },
          "requested_epoch_ms": {
            "type": "integer",
            "minimum": 0
          },
          "acquired_epoch_ms": {
            "type": "integer",
            "minimum": 0
          },
          "released_epoch_ms": {
            "type": "integer",
            "minimum": 0
          },
          "wait_ms": {
            "type": "integer",
            "minimum": 0
          },
          "hold_ms": {
            "type": "integer",
            "minimum": 0
          },
          "thread": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "dbt_node_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "request_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      }
    }
  }
}
