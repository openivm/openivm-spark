8" height="15" as="geometry"/></mxCell><mxCell id="lake_details" value="Capture → ZIP → upload&lt;br&gt;→ commit marker → prune&lt;br&gt;Not a copy of Delta tables." style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;text;align=left;verticalAlign=middle;spacing=0;fontSize=8;fontColor=#605E5C;fontSize=8;fontSize=7.5;" vertex="1" parent="lake_card"><mxGeometry x="10" y="28" width="187" height="38" as="geometry"/></mxCell><mxCell id="lake_pub_a" value="&lt;b&gt;A · 1 request · 6.119 s&lt;/b&gt;&lt;br&gt;MV 6, including barrier wait." style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;text;align=left;verticalAlign=middle;spacing=0;fontSize=8;fontColor=#605E5C;fontSize=8;fontSize=7.5;" vertex="1" parent="lake_card"><mxGeometry x="10" y="78" width="187" height="36" as="geometry"/></mxCell><mxCell id="lake_pub_b" value="&lt;b&gt;B · 5 requests · 0.432 s&lt;/b&gt;&lt;br&gt;One shared pass for MVs 1–5;&lt;br&gt;starts 2 ms after A ends." style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;text;align=left;verticalAlign=middle;spacing=0;fontSize=8;fontColor=#605E5C;fontSize=8;fontSize=7.5;" vertex="1" parent="lake_card"><mxGeometry x="10" y="121" width="187" height="45" as="geometry"/></mxCell><mxCell id="lake_note" value="Synchronous mode: commands&lt;br&gt;wait for covering publication." style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;text;align=left;verticalAlign=middle;spacing=0;fontSize=8;fontColor=#605E5C;fontSize=8;fontSize=7.5;" vertex="1" parent="lake_card"><mxGeometry x="10" y="183" width="187" height="25" as="geometry"/></mxCell><mxCell id="capture_publish" value="" style="html=1;fontFamily=Segoe UI;edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=8;jumpStyle=arc;jumpSize=6;endArrow=block;endFill=1;endSize=4;strokeColor=#605E5C;strokeWidth=1;fontColor=#605E5C;exitX=1;exitY=0.6;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="storage" source="root_card" target="lake_card"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="explain_wait" value="&lt;b&gt;Read the flames:&lt;/b&gt; MV 5&#x27;s catalog-finalization span and MV 6&#x27;s capture wait are different work.&lt;br&gt;MV 1 also waited in the publisher queue. The trace does not identify a lock holder or prove&lt;br&gt;which I/O caused a span." style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;text;align=left;verticalAlign=middle;spacing=0;fontSize=8;fontColor=#605E5C;fontSize=8;fontSize=8;verticalAlign=top;" vertex="1" parent="storage"><mxGeometry x="14" y="300" width="660" height="54" as="geometry"/></mxCell><mxCell id="sync_config" value="Lab config: catalog.backend=delta · changeFeed.mode=cdf · stateSync.async.enabled=false" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;text;align=left;verticalAlign=middle;spacing=0;fontSize=8;fontColor=#605E5C;fontSize=8;fontSize=7.5;fontColor=#005A9E;" vertex="1" parent="storage"><mxGeometry x="14" y="359" width="660" height="16" as="geometry"/></mxCell><mxCell id="key_title" value="&lt;b&gt;MEASUREMENT KEY&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;text;align=left;verticalAlign=middle;spacing=0;fontSize=8;fontColor=#605E5C;fontSize=8;fontColor=#005A9E;" vertex="1" parent="f"><mxGeometry x="24" y="773" width="660" height="17" as="geometry"/></mxCell><mxCell id="key_batch" value="Run: openivm_demo_walkthrough, scale=1 · fast-setup-v3-evidence-first&lt;br&gt;Engine clock domain f05a3952… · captured Spark 4.1.1 / Delta 4.2 · revision 3879182c…" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;text;align=left;verticalAlign=middle;spacing=0;fontSize=8;fontColor=#605E5C;fontSize=8;fontSize=8;" vertex="1" parent="f"><mxGeometry x="24" y="793" width="670" height="28" as="geometry"/></mxCell><mxCell id="key_requests" value="Request IDs (prefix): 1=8857bc10 · 2=65d2eab5 · 3=54a30088&lt;br&gt;4=07675c0c · 5=f7a0ab56 · 6=0500f0b2 · each has its own report.json" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;text;align=left;verticalAlign=middle;spacing=0;fontSize=8;fontColor=#605E5C;fontSize=8;fontSize=8;" vertex="1" parent="f"><mxGeometry x="24" y="828" width="670" height="35" as="geometry"/></mxCell><mxCell id="key_pub" value="Publication A = 54875ac3… · B = d76bc85b… · durations rounded to milliseconds&lt;br&gt;Receipt paths: &amp;lt;request ID&amp;gt;/report.json → raw_telemetry.completed[0] + events" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;text;align=left;verticalAlign=middle;spacing=0;fontSize=8;fontColor=#605E5C;fontSize=8;fontSize=8;" vertex="1" parent="f"><mxGeometry x="24" y="871" width="670" height="28" as="geometry"/></mxCell><mxCell id="footer" value="Snapshot timing is inside command timing; parent and child spans must not be summed. Wall-clock locations are simplified, not a physical query plan.&lt;br&gt;Delta Lake logo © The Delta Lake Project Authors, Apache 2.0. Scala mark: scala-lang.org." style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;text;align=left;verticalAlign=middle;spacing=0;fontStyle=2;fontSize=8;fontColor=#605E5C;fontSize=7.5;verticalAlign=top;" vertex="1" parent="f"><mxGeometry x="24" y="916" width="670" height="44" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>